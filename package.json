{
  "name": "bess-net",
  "version": "0.1.0",
  "private": true,
  "description": "蓄電所ネット — 系統用蓄電池・低圧リソース事業の情報ポータル",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:glossary-faq-index && npm run build:subsidies",
    "build:glossary-faq-index": "tsx scripts/build-glossary-faq-index.ts",
    "build:subsidies": "tsx scripts/precompute-subsidies.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "verify:linkify": "tsx scripts/verify-no-nested-anchors.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "microcms-js-sdk": "^3.1.4",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
