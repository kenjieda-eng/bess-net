{
  "name": "bess-net",
  "version": "0.1.0",
  "private": true,
  "description": "蓄電所ネット — 系統用蓄電池・低圧リソース事業の情報ポータル",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:glossary-faq-index && npm run build:glossary-detail && npm run build:subsidies && npm run build:substations && npm run precompute-eic-data && npm run build:legacy-news-allowlist && npm run build:operator-ranking",
    "build:operator-ranking": "tsx scripts/precompute-operator-ranking.ts",
    "build:glossary-detail": "tsx scripts/precompute-glossary-detail.ts",
    "build:legacy-news-allowlist": "tsx scripts/build-legacy-news-allowlist.ts",
    "build:glossary-faq-index": "tsx scripts/build-glossary-faq-index.ts",
    "build:subsidies": "tsx scripts/precompute-subsidies.ts",
    "build:substations": "tsx scripts/precompute-substations.ts",
    "precompute-eic-data": "tsx scripts/precompute-eic-data.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "verify:linkify": "tsx scripts/verify-no-nested-anchors.ts",
    "precompute:hazard": "tsx scripts/precompute-hazard-risk.ts"
  },
  "dependencies": {
    "csv-parse": "^6.2.1",
    "leaflet": "^1.9.4",
    "microcms-js-sdk": "^3.1.4",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0"
  },
  "devDependencies": {
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
